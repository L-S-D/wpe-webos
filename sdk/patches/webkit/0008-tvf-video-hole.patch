 using namespace HTMLNames;
 
+#if USE(COORDINATED_GRAPHICS)
+// TVF: an element with the attribute tvf-hole shows a hole for the TV's video
+// plane instead of its content box. The layer's contents are WebKit's hole
+// punch buffer (transparent black, drawn without blending), so everything
+// composited below the element is cut away and everything above it stays -
+// the video hole of a TV browser, without media support in WebKit. The
+// element needs its own compositing layer (e.g. will-change: transform);
+// Element::attributeChanged reconfigures it when the attribute changes.
+static bool tvfHasHole(const RenderLayerModelObject& renderer)
+{
+    static NeverDestroyed<const QualifiedName> name(nullAtom(), AtomString("tvf-hole"_s), nullAtom());
+    RefPtr element = renderer.element();
+    return element && element->hasAttributeWithoutSynchronization(name.get());
+}
+
+// hole buffer proxy per backing (keyed by address, removed with the backing)
+static HashMap<uintptr_t, Ref<CoordinatedPlatformLayerBufferProxy>>& tvfHoles()
+{
+    static NeverDestroyed<HashMap<uintptr_t, Ref<CoordinatedPlatformLayerBufferProxy>>> holes;
+    return holes;
+}
+#endif
