+                if (auto glDisplay = GLDisplay::create(eglGetDisplay(reinterpret_cast<EGLNativeDisplayType>(waylandDisplay)))) {
+                    WTFLogAlways("Using the Wayland display for EGL");
+                    return std::unique_ptr<PlatformDisplayDefault>(new PlatformDisplayDefault(glDisplay.releaseNonNull()));
+                }
+            }
+        }
+    }
+    WTFLogAlways("Could not create default EGL display: %s", GLContext::lastErrorString());
+    return nullptr;
+#endif
+
