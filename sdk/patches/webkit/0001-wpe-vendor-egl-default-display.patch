+    if (auto glDisplay = GLDisplay::create(eglGetDisplay(EGL_DEFAULT_DISPLAY)))
+        return std::unique_ptr<PlatformDisplayDefault>(new PlatformDisplayDefault(glDisplay.releaseNonNull()));
+    if (void* wayland = dlopen("libwayland-client.so.0", RTLD_NOW | RTLD_GLOBAL)) {
