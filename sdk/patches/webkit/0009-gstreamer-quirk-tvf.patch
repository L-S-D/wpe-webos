+#pragma once
+
+#if USE(GSTREAMER)
+
+#include "GStreamerQuirks.h"
+
+namespace WebCore {
+
+// TVF (webOS TV): the sinks tvfvideosink/tvfaudiosink take the streams still
+// encoded and hand them to TVF, which feeds the TV's hardware decoder - the
+// split of Rialto (a media server owns the decoder), with TVF as the server.
+class GStreamerQuirkTVF final : public GStreamerQuirk {
+public:
+    GStreamerQuirkTVF();
+    const ASCIILiteral identifier() const final { return "TVF"_s; }
+    bool isPlatformSupported() const final;
+
+    void configureElement(GstElement*, const OptionSet<ElementRuntimeCharacteristics>&) final;
+    GstElement* createAudioSink() final;
+    std::optional<bool> isHardwareAccelerated(GstElementFactory*) final;
+    unsigned getAdditionalPlaybinFlags() const final { return getGstPlayFlag("text") | getGstPlayFlag("native-audio") | getGstPlayFlag("native-video"); }
+    std::optional<GstState> eosMediaPlayerState() const final { return GST_STATE_PAUSED; }
+    bool needsBufferingPercentageCorrection() const final { return true; }
+    int correctBufferingPercentage(MediaPlayerPrivateGStreamer*, int originalBufferingPercentage, GstBufferingMode) const final;
+
+private:
+    GRefPtr<GstCaps> m_sinkCaps;
+};
+
+} // namespace WebCore
+
+#endif // USE(GSTREAMER)
