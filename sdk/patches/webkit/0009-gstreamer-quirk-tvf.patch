+
+#include "config.h"
+#include "GStreamerQuirkTVF.h"
+
+#if USE(GSTREAMER)
+
+#include "GStreamerCommon.h"
+#include <array>
+#include <wtf/OptionSet.h>
+
+namespace WebCore {
+
+GST_DEBUG_CATEGORY_STATIC(webkit_tvf_quirks_debug);
+#define GST_CAT_DEFAULT webkit_tvf_quirks_debug
+
+GStreamerQuirkTVF::GStreamerQuirkTVF()
+{
+    GST_DEBUG_CATEGORY_INIT(webkit_tvf_quirks_debug, "webkitquirkstvf", 0, "WebKit TVF Quirks");
+
+    // What the sinks take (encoded): uridecodebin3 stops at these caps instead
+    // of looking for decoders, which this platform does not have.
+    std::array<ASCIILiteral, 2> sinks = { "tvfvideosink"_s, "tvfaudiosink"_s };
+    for (auto sink : sinks) {
+        GRefPtr sinkFactory = adoptGRef(gst_element_factory_find(sink.characters()));
+        if (!sinkFactory) [[unlikely]]
+            continue;
+
+        gst_object_unref(gst_plugin_feature_load(GST_PLUGIN_FEATURE(sinkFactory.get())));
+        for (auto* item = gst_element_factory_get_static_pad_templates(sinkFactory.get()); item; item = g_list_next(item)) {
+            auto* padTemplate = static_cast<GstStaticPadTemplate*>(item->data);
+            if (padTemplate->direction != GST_PAD_SINK)
+                continue;
+            GRefPtr<GstCaps> templateCaps = adoptGRef(gst_static_caps_get(&padTemplate->static_caps));
+            if (!templateCaps || gst_caps_is_empty(templateCaps.get()) || gst_caps_is_any(templateCaps.get()))
+                continue;
+            if (m_sinkCaps)
+                m_sinkCaps = adoptGRef(gst_caps_merge(m_sinkCaps.leakRef(), templateCaps.leakRef()));
+            else
+                m_sinkCaps = WTF::move(templateCaps);
+        }
+    }
+}
+
+bool GStreamerQuirkTVF::isPlatformSupported() const
+{
+    GRefPtr sinkFactory = adoptGRef(gst_element_factory_find("tvfvideosink"));
+    if (!sinkFactory)
+        return false;
+    return gst_plugin_feature_get_rank(GST_PLUGIN_FEATURE(sinkFactory.get())) > GST_RANK_MARGINAL;
+}
+
+// parsebin (urisourcebin for MSE, decodebin3 for files): a stream that is
+// parsed/framed already and that the sinks take goes out as it is. A second
+// parser would only rewrite time stamps - WebKit's MSE clamps the negative DTS
+// of the first B-frame pictures to 0 and h264parse then moves their PTS. The
+// sinks convert themselves (avc -> byte-stream, raw AAC -> ADTS). Connected
+// before WebKit's own handler, which then is not asked.
+static unsigned tvfParsebinAutoplugSelect(GstElement*, GstPad*, GstCaps* caps, GstElementFactory* factory, GstCaps* sinkCaps)
+{
+    static auto tryAutoPlug = *gstGetAutoplugSelectResult("try"_s);
+    static auto exposeAutoPlug = *gstGetAutoplugSelectResult("expose"_s);
+    if (!gst_element_factory_list_is_type(factory, GST_ELEMENT_FACTORY_TYPE_PARSER))
+        return tryAutoPlug;
+    auto* structure = gst_caps_get_structure(caps, 0);
+    gboolean parsed = FALSE;
+    gboolean framed = FALSE;
+    gst_structure_get_boolean(structure, "parsed", &parsed);
+    gst_structure_get_boolean(structure, "framed", &framed);
+    bool complete = parsed || framed || !g_strcmp0(gst_structure_get_string(structure, "alignment"), "au");
+    if (complete && gst_caps_can_intersect(caps, sinkCaps)) {
+        GST_DEBUG("Exposing %" GST_PTR_FORMAT " without %s", caps, GST_OBJECT_NAME(factory));
+        return exposeAutoPlug;
+    }
+    return tryAutoPlug;
+}
+
+void GStreamerQuirkTVF::configureElement(GstElement* element, const OptionSet<ElementRuntimeCharacteristics>&)
+{
+    if (!m_sinkCaps)
+        return;
+    auto typeName = unsafeSpan(G_OBJECT_TYPE_NAME(G_OBJECT(element)));
+    if (equal(typeName, "GstURIDecodeBin3"_s)) {
+        GRefPtr<GstCaps> defaultCaps;
+        g_object_get(element, "caps", &defaultCaps.outPtr(), nullptr);
+        defaultCaps = adoptGRef(gst_caps_merge(gst_caps_ref(m_sinkCaps.get()), defaultCaps.leakRef()));
+        GST_INFO("Setting stop caps to %" GST_PTR_FORMAT, defaultCaps.get());
+        g_object_set(element, "caps", defaultCaps.get(), nullptr);
+    }
+
+    // the quirk lives as long as the process, so do its caps
+    if (equal(typeName, "GstParseBin"_s))
+        g_signal_connect(element, "autoplug-select", G_CALLBACK(tvfParsebinAutoplugSelect), m_sinkCaps.get());
+}
+
+GstElement* GStreamerQuirkTVF::createAudioSink()
+{
+    auto sink = makeGStreamerElement("tvfaudiosink"_s);
+    RELEASE_ASSERT_WITH_MESSAGE(sink, "tvfaudiosink should be available but it is not");
+    return sink;
+}
+
+std::optional<bool> GStreamerQuirkTVF::isHardwareAccelerated(GstElementFactory* factory)
+{
+    if (StringView::fromLatin1(GST_OBJECT_NAME(factory)).startsWith("tvf"_s))
+        return true;
+    return std::nullopt;
+}
+
+// The TV's decoder holds seconds of data and rides out underruns itself (its
+// position just stops). WebKit's in-memory buffering only sees the small queue
+// in front of the sinks, which they drain in bursts whenever the TV takes data
+// - it would pause and resume the pipeline several times a second (and every
+// pause and resume goes on to the TV). Like the Broadcom quirk adds the data
+// in its decoder, this counts the queue as full.
+int GStreamerQuirkTVF::correctBufferingPercentage(MediaPlayerPrivateGStreamer*, int originalBufferingPercentage, GstBufferingMode mode) const
+{
+    return mode == GST_BUFFERING_STREAM ? 100 : originalBufferingPercentage;
+}
+
+#undef GST_CAT_DEFAULT
+
+} // namespace WebCore
+
+#endif // USE(GSTREAMER)
