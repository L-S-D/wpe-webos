+
+namespace WebCore {
+
+GstElement* GStreamerHolePunchQuirkTVF::createHolePunchVideoSink(bool, const MediaPlayer*)
+{
+    return makeGStreamerElement("tvfvideosink"_s);
+}
+
+bool GStreamerHolePunchQuirkTVF::setHolePunchVideoRectangle(GstElement* videoSink, const IntRect& rect)
+{
+    if (!gstObjectHasProperty(videoSink, "rectangle"_s)) [[unlikely]]
+        return false;
+
+    auto rectString = makeString(rect.x(), ',', rect.y(), ',', rect.width(), ',', rect.height());
+    g_object_set(videoSink, "rectangle", rectString.ascii().data(), nullptr);
+    return true;
+}
+
