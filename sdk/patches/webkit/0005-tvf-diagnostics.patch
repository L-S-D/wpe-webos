 namespace WebCore {
 
+// TVF diagnostics (webOS/Mali bring-up): TVF_WEB_GL_DEBUG=1 creates debug
+// contexts and prints KHR_debug messages of the GL driver to stderr - this
+// build has no release logging, so WebKit's own GLContext logging is gone.
+static bool tvfGLDebug()
+{
+    static const bool enabled = getenv("TVF_WEB_GL_DEBUG");
+    return enabled;
+}
+
+static void tvfLogGLDebugMessage(GLenum source, GLenum type, GLuint identifier, GLenum severity, GLsizei, const GLchar* message, const void*)
+{
+    static std::atomic<unsigned> count { 0 };
+    unsigned n = count++;
+    if (n < 400)
+        WTFLogAlways("[tvf-gl] source=0x%x type=0x%x id=%u severity=0x%x: %s", source, type, identifier, severity, message);
+    else if (n == 400)
+        WTFLogAlways("[tvf-gl] more GL debug messages suppressed");
+}
+
+static void tvfEnableGLDebugOutput(EGLContext context)
+{
+    static Lock lock;
+    static Vector<EGLContext> enabledContexts;
+    {
+        Locker locker { lock };
+        if (enabledContexts.contains(context))
+            return;
+        enabledContexts.append(context);
+    }
+    const char* extensions = reinterpret_cast<const char*>(glGetString(GL_EXTENSIONS));
+    bool hasDebug = extensions && strstr(extensions, "GL_KHR_debug");
+    WTFLogAlways("[tvf-gl] context %p current: %s / %s, KHR_debug %s", context, glGetString(GL_RENDERER), glGetString(GL_VERSION), hasDebug ? "yes" : "no");
+    if (!hasDebug)
+        return;
+    glDebugMessageCallbackKHR(tvfLogGLDebugMessage, nullptr);
+    glEnable(GL_DEBUG_OUTPUT_KHR);
+    glEnable(GL_DEBUG_OUTPUT_SYNCHRONOUS_KHR);
+}
+
