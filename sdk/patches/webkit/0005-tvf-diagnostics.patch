+static void tvfLogReadback(const char* path, const ShareableBitmap& bitmap, bool readOk)
+{
+    static unsigned frames = 0;
+    if (!tvfGLDebug() || frames++ >= 12)
+        return;
+    auto span = bitmap.span();
+    unsigned width = bitmap.size().width(), height = bitmap.size().height(), stride = bitmap.bytesPerRow();
+    unsigned samples = 0, visible = 0, nonWhite = 0;
+    uint32_t first = 0, distinct = 0;
+    for (unsigned y = 0; y < height; y += 8) {
+        for (unsigned x = 0; x < width; x += 8) {
+            size_t offset = static_cast<size_t>(y) * stride + x * 4;
+            if (offset + 4 > span.size())
+                continue;
+            uint32_t pixel;
+            memcpy(&pixel, span.data() + offset, 4);
+            if (!samples)
+                first = pixel;
+            else if (pixel != first)
+                distinct++;
+            samples++;
+            if (pixel >> 24)
+                visible++;
+            if (pixel != 0xffffffff)
+                nonWhite++;
+        }
+    }
+    WTFLogAlways("[tvf-gl] readback %s frame %u: %ux%u read %s, glGetError 0x%x, samples %u visible %u non-white %u different-from-first %u, first BGRA %08x",
+        path, frames, width, height, readOk ? "ok" : "FAILED", glGetError(), samples, visible, nonWhite, distinct, first);
+}
